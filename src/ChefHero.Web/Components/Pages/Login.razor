@page "/login"

<PageTitle>Sign in</PageTitle>

<section class="mx-auto max-w-md">
    <h1 class="mb-6 text-3xl font-bold">Sign in</h1>

    @if (Error == "invalid")
    {
        <p class="mb-4" role="alert">The email or password is incorrect.</p>
    }
    else if (Error == "unavailable")
    {
        <p class="mb-4" role="alert">Sign in is unavailable right now. Please try again.</p>
    }
    else if (LoggedOut)
    {
        <p class="mb-4" role="status">You have been signed out.</p>
    }

    <form method="post" action="/account/login">
        <AntiforgeryToken />

        <div class="mb-4">
            <label class="mb-1 block" for="email">Email</label>
            <input id="email"
                   name="Email"
                   class="w-full rounded border border-border bg-background px-3 py-2"
                   type="email"
                   autocomplete="username"
                   maxlength="128"
                   required />
        </div>

        <div class="mb-4">
            <label class="mb-1 block" for="password">Password</label>
            <input id="password"
                   name="Password"
                   class="w-full rounded border border-border bg-background px-3 py-2"
                   type="password"
                   autocomplete="current-password"
                   minlength="8"
                   maxlength="128"
                   required />
        </div>

        <button class="rounded bg-primary px-4 py-2 text-primary-foreground"
                type="submit">
            Sign in
        </button>
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "loggedOut")]
    private bool LoggedOut { get; set; }
}
